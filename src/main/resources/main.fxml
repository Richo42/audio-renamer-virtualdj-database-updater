<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.renamer.controller.MainController">

    <!-- Título -->
    <top>
        <HBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <!-- Espacio flexible a la izquierda (empuja todo al centro/derecha) -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Espacio flexible -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Botón About (a la derecha) -->
            <Button onAction="#handleAbout" style="-fx-background-color: transparent; -fx-text-fill: #0077B5; -fx-cursor: hand; -fx-graphic-text-gap: 6;" text="About">
                <graphic>
                    <FontIcon fill="#0077B5" iconLiteral="fas-info-circle" iconSize="16" />
                </graphic>
                <tooltip>
                    <Tooltip text="About Audio Renamer" />
                </tooltip>
            </Button>
        </HBox>
    </top>

    <!-- Contenido Central -->
    <center>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- Título principal (centrado visualmente) -->
            <Label alignment="CENTER" contentDisplay="CENTER" text="Audio Renamer - VirtualDJ Database Updater" textAlignment="CENTER">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>

            <!-- Botón Seleccionar Carpeta -->
            <Button fx:id="btnSelectFolder" mnemonicParsing="false" onAction="#handleSelectFolder" prefWidth="250" text="📁 Seleccionar Carpeta de Origen" />

            <!-- Label de Ruta -->
            <Label fx:id="lblFolderPath" maxWidth="400" style="-fx-text-fill: #666; -fx-font-size: 12px;" text="Ninguna carpeta seleccionada" wrapText="true" />

            <!-- Separador -->
            <Label style="-fx-text-fill: #ccc;" text="─────────────────────────────" />

            <!-- 🔑 NUEVO: Botón Seleccionar database.xml -->
            <Button fx:id="btnSelectDatabase" mnemonicParsing="false" onAction="#handleSelectDatabase" prefWidth="250" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="🎧 Seleccionar database.xml (VirtualDJ)" />

            <!-- Label de Ruta Database -->
            <Label fx:id="lblDatabasePath" maxWidth="400" style="-fx-text-fill: #666; -fx-font-size: 11px;" text="Database.xml no seleccionado" wrapText="true" />

            <!-- Botón Iniciar -->
            <Button fx:id="btnStart" disable="true" mnemonicParsing="false" onAction="#handleStart" prefWidth="250" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="▶ Iniciar Renombrado" />
        </VBox>
    </center>

    <!-- Barra de Progreso y Estado -->
    <bottom>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <!-- Barra de Progreso -->
            <ProgressBar fx:id="progressBar" maxWidth="1.0" progress="0.0" HBox.hgrow="ALWAYS" />

            <!-- HBox para Estado y Crédito (misma línea) -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <!-- Label de Estado (izquierda) -->
                <Label fx:id="lblStatus" style="-fx-font-size: 13px;" text="Listo para comenzar" HBox.hgrow="ALWAYS" />

                <!-- Espacio flexible para empujar el crédito a la derecha -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Crédito del desarrollador (derecha) -->
                <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;" text="Audio Renamer v1.0 | Developed by Ricardo Castillo" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
