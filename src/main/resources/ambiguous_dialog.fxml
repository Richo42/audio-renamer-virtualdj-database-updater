<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.Slider?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox alignment="CENTER" prefHeight="300.0" prefWidth="500.0" spacing="20.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.renamer.controller.AmbiguousDialogController"
      style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Título -->
    <Label text="Separar Artista y Canción" textAlignment="CENTER">
        <font>
            <Font name="System Bold" size="16.0" />
        </font>
    </Label>

    <!-- Nombre original (solo lectura para copiar si es necesario) -->
    <VBox spacing="5.0">
        <Label text="Nombre original:" style="-fx-font-weight: bold;" />
        <TextField fx:id="txtOriginalName" editable="false" style="-fx-background-color: #e0e0e0;" />
    </VBox>

    <!-- Campo Artista -->
    <VBox spacing="5.0">
        <Label text="ARTISTA:" style="-fx-font-weight: bold;" />
        <TextField fx:id="txtArtist" prefWidth="400" maxWidth="Infinity" promptText="Ingresa el nombre del artista" />
    </VBox>

    <!-- Campo Canción -->
    <VBox spacing="5.0">
        <Label text="CANCIÓN:" style="-fx-font-weight: bold;" />
        <TextField fx:id="txtSong" promptText="Ingresa el nombre de la canción" />
    </VBox>

    <!-- SECCIÓN DEL MINI REPRODUCTOR -->
    <VBox spacing="5" alignment="CENTER" style="-fx-padding: 10 0 10 0; -fx-border-color: #ccc; -fx-border-width: 0 0 1 0;">

        <!-- Etiqueta de tiempo actual / total -->
        <Label fx:id="lblTime" text="00:00 / 00:00" style="-fx-font-size: 12px; -fx-text-fill: #666;" />

        <!-- Barra de progreso (Timeline) -->
        <!-- min="0", max="100" se actualizarán dinámicamente en Java -->
        <Slider fx:id="sliderProgress" min="0" max="100" value="0" prefWidth="300" />

        <!-- Botones de control -->
        <HBox spacing="10" alignment="CENTER">
            <!-- Botón Play/Pause con icono vectorial -->
            <Button fx:id="btnPlay" onAction="#onPlayPause" prefWidth="110">
                <graphic>
                    <HBox alignment="CENTER" spacing="5">
                        <FontIcon iconLiteral="fas-play" iconSize="14" fill="#4CAF50"/>
                        <Label text="Reproducir"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Botón Stop con icono vectorial -->
            <Button fx:id="btnStop" onAction="#onStop" prefWidth="110">
                <graphic>
                    <HBox alignment="CENTER" spacing="5">
                        <FontIcon iconLiteral="fas-stop" iconSize="14" fill="#f44336"/>
                        <Label text="Detener"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>

    </VBox>

    <!-- Botones -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnAccept" onAction="#handleAccept" text="Aceptar"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-pref-width: 100;" />
        <Button fx:id="btnSkip" onAction="#handleSkip" text="Omitir"
                style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-pref-width: 100;" />
        <Button fx:id="btnCancel" onAction="#handleCancel" text="Cancelar Todo"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-pref-width: 120;" />
    </HBox>

</VBox>